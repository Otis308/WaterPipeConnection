{
    "name": "huit/water-pipe-game-laravel12",
    "type": "project",
    "description": "Đồ án cuối kỳ môn Lập trình mã nguồn mở (HUIT) - Game Nối Ống Nước (Laravel 12, OOP PHP, PDO MySQL, AJAX Fetch API, Docker)",
    "keywords": ["laravel", "php", "oop", "pdo", "mysql", "huit", "water-pipe-game"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.3",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
